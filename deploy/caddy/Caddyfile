# Caddy gets and renews the HTTPS certificate for SITE_ADDRESS by itself
# (Let's Encrypt).  For a local trial SITE_ADDRESS=localhost uses Caddy's
# own local certificate authority instead.
{
	# Behind Cloudflare's proxy, uncomment so {client_ip} is the visitor's
	# address, not Cloudflare's.  Ranges: https://www.cloudflare.com/ips/
	# servers {
	# 	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# 	client_ip_headers CF-Connecting-IP
	# }
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		-Server
	}

	# Supplier documents live in the same volume but are private: the owner
	# downloads them through the app, behind the two-factor login.
	handle /media/private/* {
		respond 404
	}

	# Uploaded files (product photos) are served straight from the volume.
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy web:8000 {
			# Overwrite, never append: Django trusts this header for the
			# visitor's address (login lockout, audit log).
			header_up X-Real-IP {client_ip}
		}
	}

	log {
		output stdout
		format json
	}
}
