[Unit]
Description=Teashop encrypted off-site backup (restic)
Wants=network-online.target docker.service
After=network-online.target docker.service
# Retry once after a transient failure (network, B2 hiccup), then give up
# and let the healthcheck ping report it.
StartLimitIntervalSec=2h
StartLimitBurst=2

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/teashop
# Runs backup.sh in the backup container and records the result in the
# audit log (owner dashboard).
ExecStart=/srv/teashop/deploy/backup-job.sh backup
Restart=on-failure
RestartSec=15min
