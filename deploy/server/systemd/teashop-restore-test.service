[Unit]
Description=Teashop backup restore test (scratch database, live data untouched)
Wants=network-online.target docker.service
After=network-online.target docker.service teashop-backup.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/teashop
# Runs restore-test.sh in the backup container and records the result in
# the audit log (owner dashboard).
ExecStart=/srv/teashop/deploy/backup-job.sh restore-test
