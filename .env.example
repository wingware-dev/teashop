# Copy to .env (never commit .env) and fill in.  Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# The shop's domain, e.g. shop.example.com.  For a local trial: localhost
SITE_DOMAIN=localhost
# What Caddy serves; defaults to SITE_DOMAIN.  Local trial on other ports:
#   SITE_ADDRESS=localhost  HTTP_PORT=8080  HTTPS_PORT=8443
#   CSRF_TRUSTED_ORIGINS=https://localhost:8443
# SITE_ADDRESS=
# HTTP_PORT=80
# HTTPS_PORT=443
# CSRF_TRUSTED_ORIGINS=

DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# A hard-to-guess admin path, ending in a slash, e.g. office-7f3a/
DJANGO_ADMIN_URL=admin/

# Start HSTS at a day; raise to 31536000 (a year) once HTTPS is known good.
DJANGO_SECURE_HSTS_SECONDS=86400

# Error tracking (optional): the DSN of a Sentry project.
SENTRY_DSN=

# Backups with restic.  The password encrypts the backups: keep a copy
# off the server (password manager), or the backups cannot be restored.
RESTIC_PASSWORD=change-me
# Local trial: leave as is (writes to ./backups/restic-local).
# Production: b2:<bucket-name>:teashop plus the B2 application key below.
RESTIC_REPOSITORY=/backups/restic-local
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Optional dead-man's switch: a healthchecks.io (or similar) ping URL that
# alerts you when a backup fails or doesn't run.
BACKUP_HEALTHCHECK_URL=
# The same for the monthly restore test (a separate check, monthly period).
RESTORE_HEALTHCHECK_URL=
