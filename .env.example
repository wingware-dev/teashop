# Copy to .env (never commit .env) and fill in.  Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# The shop's domain, e.g. shop.example.com.  For a local trial: localhost
SITE_DOMAIN=localhost
# What Caddy serves; defaults to SITE_DOMAIN.  Local trial on other ports:
#   SITE_ADDRESS=localhost  HTTP_PORT=8080  HTTPS_PORT=8443
#   CSRF_TRUSTED_ORIGINS=https://localhost:8443
# SITE_ADDRESS=
# HTTP_PORT=80
# HTTPS_PORT=443
# CSRF_TRUSTED_ORIGINS=

DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# A hard-to-guess admin path, ending in a slash, e.g. office-7f3a/
DJANGO_ADMIN_URL=admin/

# Start HSTS at a day; raise to 31536000 (a year) once HTTPS is known good.
DJANGO_SECURE_HSTS_SECONDS=86400

# The packer's name and address printed on every package label, with \n
# between lines.  A street address is required unless the business is
# listed in a current phone or city directory.
LABEL_PACKER_ADDRESS=
# Warn on the dashboard this many days before a lot's best-by date.
# INVENTORY_BEST_BY_WARNING_DAYS=60
# Organic sales allowed a year without certification, and the amount from
# which the dashboard warns.
# ORGANIC_EXEMPTION_LIMIT=5000
# ORGANIC_SALES_ALERT=4000

# The shop.  Until STOREFRONT_OPEN=true, visitors see only "coming soon"
# and search engines are kept out; you see the whole shop when signed in.
STOREFRONT_OPEN=false
# The shop's name in the header, titles and search results.
SHOP_NAME=Teashop
# Protected origin names, comma-separated, usable only for products marked
# "Origin certified".  Empty uses the built-in list (config/settings.py).
CATALOG_PROTECTED_ORIGINS=

# The shop's address on the web, for links in emails, e.g. https://shop.example.com
SITE_URL=
# Where customers write, and the postal address (a registered PO box is
# fine) shown in emails and the policies, with \n between lines.
SHOP_CONTACT_EMAIL=
SHOP_POSTAL_ADDRESS=

# Email (order confirmations, shipping, sign-in links, subscription
# notices).  Without EMAIL_HOST emails are printed to the log, not sent.
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Marketing email list (docs/emaillist.md): the bulk sender's SMTP settings
# (Amazon SES recommended), and the From address on the domain set up with
# SPF, DKIM and DMARC.  Without EMAIL_LIST_EMAIL_HOST mailings use EMAIL_HOST.
EMAIL_LIST_EMAIL_HOST=
EMAIL_LIST_EMAIL_PORT=587
EMAIL_LIST_EMAIL_HOST_USER=
EMAIL_LIST_EMAIL_HOST_PASSWORD=
EMAIL_LIST_FROM_EMAIL=
EMAIL_LIST_ID=
# New-order and problem notices for you.
OWNER_NOTIFY_EMAIL=
# New orders: "daily" (one summary at 6pm) or "each" (an email per order).
# OWNER_NEW_ORDER_EMAILS=daily
# Reminders for the dashboard's "Needs your attention" list (docs/reports.md):
# deadlines per kind that differ from the defaults, and the daily reminder.
# ATTENTION_DEADLINES=support=0,refunds=4h,approvals=3d
# ATTENTION_DAILY_AT=08:00
# Wave (accounting): "fake" keeps each day's summary here only; "wave"
# posts it (docs/reports.md, "The daily summary for Wave").
WAVE_CLIENT=fake
WAVE_TOKEN=
WAVE_BUSINESS_ID=
# anchor=<Stripe clearing account id>,tea_sales=...,goods_sales=...,
# shipping_income=...,sales_tax=...,refunds=...,payment_fees=...
WAVE_ACCOUNTS=
WAVE_START_DATE=
# Quarterly estimated tax set-aside rates (placeholders; ask your preparer).
# ESTIMATED_TAX_FEDERAL_RATE=0.12
# ESTIMATED_TAX_STATE_RATE=0.055
# Labels: the shipping label for the 4x6 thermal printer, PDF (print from
# the browser) or ZPL; and the pouch or tin label's size in inches.
# SHIPPING_LABEL_FORMAT=PDF
# PACKAGE_LABEL_SIZE=4x2

# Checkout stays closed in production until these are set (docs/checkout.md).
# Stripe: use TEST keys (sk_test_..., pk_test_...) until you decide to go
# live; live keys are refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_ALLOW_LIVE=false
# EasyPost: a test key (EZTK...) until you approve buying real postage
# (then EASYPOST_ALLOW_LIVE=true).
EASYPOST_API_KEY=
# Where parcels ship from.
SHIP_FROM_NAME=
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=NY
SHIP_FROM_ZIP=
SHIP_FROM_PHONE=
# Sales tax rates: "table" (the rates you enter in the admin) or "stripe"
# (Stripe Tax, about 0.5% per order).  States where you collect:
# TAX_PROVIDER=table
# SALES_TAX_STATES=NY
# Cloudflare Turnstile bot check on checkout and sign-in (optional, free).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Where browsers report what the Content-Security-Policy blocked (optional).
CSP_REPORT_URI=

# Error tracking (optional): the DSN of a Sentry project.
SENTRY_DSN=

# Backups with restic.  The password encrypts the backups: keep a copy
# off the server (password manager), or the backups cannot be restored.
RESTIC_PASSWORD=change-me
# Local trial: leave as is (writes to ./backups/restic-local).
# Production: b2:<bucket-name>:teashop plus the B2 application key below.
RESTIC_REPOSITORY=/backups/restic-local
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Optional dead-man's switch: a healthchecks.io (or similar) ping URL that
# alerts you when a backup fails or doesn't run.
BACKUP_HEALTHCHECK_URL=
# The same for the monthly restore test (a separate check, monthly period).
RESTORE_HEALTHCHECK_URL=
