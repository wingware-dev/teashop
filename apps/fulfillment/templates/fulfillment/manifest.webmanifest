{% load static %}{
  "name": "{{ shop_name|default:'Teashop'|escapejs }} packing",
  "short_name": "Packing",
  "description": "Pack, label and ship orders",
  "id": "{% url 'fulfillment:queue' %}",
  "start_url": "{% url 'fulfillment:queue' %}",
  "scope": "{% url 'fulfillment:queue' %}",
  "display": "standalone",
  "background_color": "#f7f2e8",
  "theme_color": "#3d6b3a",
  "icons": [
    {"src": "{% static 'img/packing-icon-192.png' %}", "sizes": "192x192", "type": "image/png"},
    {"src": "{% static 'img/packing-icon-512.png' %}", "sizes": "512x512", "type": "image/png"},
    {"src": "{% static 'img/packing-icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
